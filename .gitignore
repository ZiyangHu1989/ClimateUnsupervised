# Keep all dataset contents local; only empty directory placeholders are tracked.
data/**
!data/raw/
!data/interim/
!data/processed/
!data/external/
**/raw/**
data/raw/*
data/interim/*
data/processed/*
data/external/*
data/*.log
data/*.pid
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

results/models/*
results/metrics/*
results/figures/*
results/manifests/*
!results/metrics/*.json
!results/manifests/*.json
!results/models/.gitkeep
!results/metrics/.gitkeep
!results/figures/.gitkeep
!results/manifests/.gitkeep

__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
.conda-env/
.env
.env.*
!.env.example
.cdsapirc
*.pem
*.key
*.egg-info/
.DS_Store

runs/*/data/
runs/*/results/models/
runs/*/results/figures/
runs/*/results/metrics/*
!runs/*/results/metrics/*.json
runs/*/results/manifests/*
!runs/*/results/manifests/*.json
